# Copy this file to .env and fill in your keys. Never put real keys in this template.
# Never commit .env to git

# Research - https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Writing + HTML assembly - https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Infographics (Kie.ai Nano Banana Pro) - https://kie.ai/api-key
# Paste the key only, without the word "Bearer"
KIE_API_KEY=your_kie_api_key_here
KIE_IMAGE_MODEL=nano-banana-pro

# Google OAuth client (Cloud Console > Credentials > OAuth client ID, Desktop app).
# Gmail API and Sheets API must be enabled. token.json is created on first run.
# Alternative: put the downloaded credentials.json in the project root and leave these two blank.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GMAIL_TOKEN_PATH=token.json

# Address that receives test sends (--test)
NEWSLETTER_TEST_RECIPIENT=

# Google Sheets archive (spreadsheet ID from its URL)
GOOGLE_SHEETS_ID=
